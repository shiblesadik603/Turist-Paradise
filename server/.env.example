# Port the Express server listens on
PORT=3001

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Secret used to sign/verify JWT auth tokens — generate a long random string
JWT_SECRET=

# Origin allowed to call this API (CORS), e.g. http://localhost:5173
FRONTEND_URL=

# Google Maps API key, used server-side for Places/Distance Matrix proxy routes
GOOGLE_MAPS_API_KEY=

# SSLCommerz sandbox store credentials (testbox/qwerty are SSLCommerz's public sandbox defaults)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
