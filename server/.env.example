# Port the Express server listens on
PORT=3001

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Secret used to sign/verify JWT auth tokens — generate a long random string
JWT_SECRET=

# Origin allowed to call this API (CORS), e.g. http://localhost:5173
FRONTEND_URL=

# SSLCommerz sandbox store credentials (testbox/qwerty are SSLCommerz's public sandbox defaults)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# OAuth 2.0 Client ID from Google Cloud Console (optional — "Sign in with Google" is
# disabled with a clear error until this is set). Must match client/.env's
# VITE_GOOGLE_CLIENT_ID — it's the same client ID used on both sides.
GOOGLE_CLIENT_ID=

# Redis connection string. Defaults to redis://localhost:6379. Caching skips itself
# gracefully without Redis, but the trip-plan generation queue genuinely needs it.
REDIS_URL=

# Google Gemini API key for the AI trip planner, now called server-side as a queued
# background job (optional — POST /planner/generate returns a clear 503 without it).
GEMINI_API_KEY=
