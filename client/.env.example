# Base URL of the backend API, e.g. http://localhost:3001
VITE_BACKEND_URL=

# OpenWeatherMap API key for the forecast widget
VITE_OPENWEATHER_API_KEY=

# Google Gemini API key for the AI itinerary planner
VITE_GEMINI_API_KEY=

# OAuth 2.0 Client ID from Google Cloud Console (optional — the "Continue with
# Google" button only renders if this is set). Must match server/.env's
# GOOGLE_CLIENT_ID — it's the same client ID used on both sides.
VITE_GOOGLE_CLIENT_ID=
